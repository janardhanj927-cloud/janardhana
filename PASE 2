  lcd.setCursor(0, 1);
  lcd.print("Neo Nexus 36.1");
  delay(2500);

  // 2. Project Title Screen
  lcd.clear();
  lcd.setCursor(0, 0);
  lcd.print("Project:");
  lcd.setCursor(0, 1);
  lcd.print("EcoSentinel");
