#include <DHT.h>
#include <ESP32Servo.h>
#include <WiFi.h>
#include <HTTPClient.h>
#include <WiFiClientSecure.h>

#define DHTPIN 4
#define DHTTYPE DHT11

#define RAIN_PIN 34
#define SOIL_PIN 32
#define GAS_PIN 35

#define TRIG_PIN 5
#define ECHO_PIN 18

#define BUZZER 26
#define SERVO_PIN 13

// --- RASPBERRY PI TRIGGER PIN ---
#define PI_TRIGGER_PIN 14

// --- WI-FI & CLOUD SETTINGS ---
const char* ssid = "Boya";         
const char* password = "sunny1961780"; 
String webAppUrl = "https://script.google.com/macros/s/AKfycbyErbjEKr0grz6LJENdO_3fUOz1nP5hbxgmScjdKb0sLP-sjEaksn9nTuwc4BlftpQQ/exec";

// --- DYNAMIC TIMING VARIABLES ---
unsigned long previousMillis = 0;
const long normalInterval = 120000; // 2 minutes
const long alertInterval = 10000;   // 10 seconds
long currentInterval = normalInterval; 
bool wasAlerting = false; // Tracks if we are currently in an alert state

LiquidCrystal_I2C lcd(0x27, 16, 2);
DHT dht(DHTPIN, DHTTYPE);
Servo gateServo;

float temperature, humidity;
int rainValue, soilValue, gasValue;
long duration;
float distance;

