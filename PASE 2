void systemStatus()
{
  bool alert = false;
  bool warning = false;

  if (gasValue > 2000 || temperature > 36.0 || temperature < 18.0 || humidity > 80.0 || humidity < 30.0) 
  {
    alert = true;
  }
  if (distance < 30 || rainValue < 1800 || soilValue > 3000) 
  {
    warning = true;
  }

  lcd.clear();

  if (alert)
  {
    lcd.setCursor(0, 0);
    lcd.print("SYSTEM ALERT");
    lcd.setCursor(0, 1);
    
    if (gasValue > 2000) {
      lcd.print("VENTILATING...");
      gateServo.write(90); 
    } else {
      lcd.print("CHECK NOW");
    }

    tone(BUZZER, 2200);
    delay(300);
    noTone(BUZZER);
    delay(100);
    tone(BUZZER, 2200);
    delay(300);
    noTone(BUZZER);
  }
  else if (warning)
  {
    lcd.setCursor(0, 0);
    lcd.print("SYSTEM WARNING");
    lcd.setCursor(0, 1);
    
    if (distance < 30) {
      lcd.print("LOCKDOWN ACTIVE");
      gateServo.write(180); 
      
      int beepDelay = map(distance, 0, 30, 50, 400); 
      tone(BUZZER, 1500);
      delay(100);
      noTone(BUZZER);
      delay(beepDelay);
    } else {
      lcd.print("CHECK SENSORS");
      gateServo.write(0); 
      tone(BUZZER, 1500);
      delay(150);
      noTone(BUZZER);
    }
  }
  else
  {
    lcd.setCursor(0, 0);
    lcd.print("SYSTEM SAFE");
    lcd.setCursor(0, 1);
    lcd.print("ALL OK");
    
    gateServo.write(0); 
    noTone(BUZZER);
  }
  
  delay(2000); 
}

void sendDataToCloud()
{
  if(WiFi.status() == WL_CONNECTED) {
    bool limitsExceeded = (gasValue > 2000 || 
                           temperature > 36.0 || temperature < 18.0 || 
                           humidity > 80.0 || humidity < 30.0 || 
                           distance < 30 || 
                           rainValue < 1800 || 
                           soilValue > 3000);
                           
    String alertStr = limitsExceeded ? "FALSE" : "TRUE";

    String url = webAppUrl + 
                 "?temp=" + String(temperature) + 
                 "&hum=" + String(humidity) + 
                 "&rain=" + String(rainValue) + 
                 "&soil=" + String(soilValue) + 
                 "&gas=" + String(gasValue) + 
                 "&dist=" + String(distance) + 
                 "&alert=" + alertStr;

    WiFiClientSecure client;
    client.setInsecure();
    HTTPClient http;

    Serial.println("Sending data to Google Sheets...");
    http.begin(client, url);
    int httpResponseCode = http.GET();
    
    if (httpResponseCode > 0) {
      Serial.print("Data logged successfully. HTTP Code: ");
      Serial.println(httpResponseCode);
    } else {
      Serial.print("Error sending data. Code: ");
      Serial.println(httpResponseCode);
    }
    http.end();
  } else {
    Serial.println("WiFi Disconnected. Cannot send data.");
  }
}

void loop() 
{
  readSensors();
  displayPages();
  systemStatus();

  // Evaluate if limits are currently exceeded
  bool limitsExceeded = (gasValue > 2000 || temperature > 36.0 || temperature < 18.0 || 
                         humidity > 80.0 || humidity < 30.0 || distance < 30 || 
                         rainValue < 1800 || soilValue > 3000);

  if (limitsExceeded) 
  {
    currentInterval = alertInterval; 
    
    if (!wasAlerting) {
      sendDataToCloud(); 
      
      // TRIGGER THE RASPBERRY PI CAMERA
      digitalWrite(PI_TRIGGER_PIN, HIGH);
      delay(500); 
      digitalWrite(PI_TRIGGER_PIN, LOW);
      
      previousMillis = millis(); 
      wasAlerting = true;
    }
  } 
  else 
  {
    currentInterval = normalInterval; 
    
    if (wasAlerting) {
      wasAlerting = false;
      previousMillis = millis(); 
    }
  }

  unsigned long currentMillis = millis();
  if (currentMillis - previousMillis >= currentInterval) {
    previousMillis = currentMillis;
    sendDataToCloud(); 
  }
}
